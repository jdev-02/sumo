;; Synthetic chain: reported success, matching file transition, and active-build remediation.
(note PC01_combined_patch_evidence)
(category general)
(time 30)
(file CombinedPatchFixture.kif)

(instance RMVuln Vulnerability)
(instance RMInstall SoftwareUpgrading)
(instance RMPatch DigitalData)
(instance RMHostA Computer)
(instance RMBefore TimeInterval)
(instance RMDuring TimeInterval)
(instance RMAfter TimeInterval)
(not (equal RMBefore RMAfter))
(not (equal RMOld RMFixed))

(dataProcessed RMInstall RMPatch)
(destination RMInstall RMHostA)
(status RMInstall ProcessSuccess)
(rmInstallationInterval RMInstall RMDuring)
(earlier RMBefore RMDuring)
(earlier RMDuring RMAfter)

(pcPatchComponentFile RMPatch RMComponent RMFilePath)
(hdExpectedDigests RMPatch RMFilePath RMDigestOld RMDigestNew)
(hdObservedDigest RMHostA RMFilePath RMBefore RMDigestOld)
(hdObservedDigest RMHostA RMFilePath RMAfter RMDigestNew)
(not (equal RMDigestOld RMDigestNew))

(rmAffectedBuild RMVuln RMComponent RMEnvironment RMOld)
(rmFixedBuild RMVuln RMComponent RMEnvironment RMFixed)
(rmActiveBuild RMHostA RMComponent RMBefore RMEnvironment RMOld)
(rmActiveBuild RMHostA RMComponent RMAfter RMEnvironment RMFixed)

(query
  (and
    (instance RMInstall SoftwareInstallation)
    (dataProcessed RMInstall RMPatch)
    (destination RMInstall RMHostA)
    (status RMInstall ProcessSuccess)
    (rmInstallationInterval RMInstall RMDuring)
    (earlier RMBefore RMDuring)
    (earlier RMDuring RMAfter)
    (pcPatchComponentFile RMPatch RMComponent RMFilePath)
    (hdExpectedDigests RMPatch RMFilePath RMDigestOld RMDigestNew)
    (hdObservedDigest RMHostA RMFilePath RMBefore RMDigestOld)
    (hdObservedDigest RMHostA RMFilePath RMAfter RMDigestNew)
    (not (equal RMDigestOld RMDigestNew))
    (rmAffectedAt RMVuln RMHostA RMComponent RMBefore)
    (not (rmAffectedAt RMVuln RMHostA RMComponent RMAfter))))
(answer yes)
