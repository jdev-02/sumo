(subclass InsufficientSpecificationBug SoftwareBug)
(termFormat EnglishLanguage InsufficientSpecificationBug "insufficient specification bug")
(documentation InsufficientSpecificationBug EnglishLanguage "A &%SoftwareBug
whose discriminating property is that two or more agents, each reading the
same &%Specification in good faith, hold different beliefs about what
&%intendedBehavior the &%Specification requires.  The &%Specification admits
multiple internally consistent readings.  Adapted from CWE-1059 (Insufficient
Technical Documentation) and IEEE 29148-2018 5.2.5 ('unambiguous' quality
characteristic).")

(=>
  (and
    (instance ?PROG ComputerProgram)
    (programBehavior ?PROG ?INPUT ?ACTUAL)
    (intendedBehavior ?PROG ?INTENDED ?AGENT)
    (not (equal ?ACTUAL ?INTENDED))
    (instance ?SPEC Specification)
    (exists (?READING1 ?READING2 ?AGENT2)
      (and
        (containsInformation ?SPEC ?READING1)
        (containsInformation ?SPEC ?READING2)
        (not (equal ?READING1 ?READING2))
        (believes ?AGENT ?READING1)
        (believes ?AGENT2 ?READING2)
        (not (equal ?AGENT ?AGENT2)))))
  (exists (?BUG)
    (and
      (instance ?BUG InsufficientSpecificationBug)
      (bugInProgram ?BUG ?PROG ?AGENT))))

