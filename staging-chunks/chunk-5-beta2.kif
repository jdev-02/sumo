(subclass UndefinedBehaviorRelianceBug SoftwareBug)
(termFormat EnglishLanguage UndefinedBehaviorRelianceBug "undefined behavior reliance bug")
(documentation UndefinedBehaviorRelianceBug EnglishLanguage "A &%SoftwareBug
whose discriminating property is &%reliesOnUndefinedBehavior : the program's
actual behavior diverges from &%intendedBehavior because the program depends
on a language construct whose behavior is itself undefined under the
&%ComputerLanguage's standard.  Anchored in CWE-758 (Reliance on Undefined,
Unspecified, or Implementation-Defined Behavior) and ISO/IEC 9899:2018
3.4.3.")

(=>
  (and
    (instance ?PROG ComputerProgram)
    (programBehavior ?PROG ?INPUT ?ACTUAL)
    (intendedBehavior ?PROG ?INTENDED ?AGENT)
    (not (equal ?ACTUAL ?INTENDED))
    (exists (?CONSTRUCT)
      (and
        (instance ?CONSTRUCT UndefinedBehaviorConstruct)
        (reliesOnUndefinedBehavior ?PROG ?CONSTRUCT))))
  (exists (?BUG)
    (and
      (instance ?BUG UndefinedBehaviorRelianceBug)
      (bugInProgram ?BUG ?PROG ?AGENT))))

